<UserControl x:Class="Pulse.OverlayCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI" FlowDirection="LeftToRight"
             TextOptions.TextRenderingMode="Grayscale">

    <!--
      Design: a night-cockpit instrument, not a HUD sticker.
      Ink-blue smoked glass, ivory DIN numerals (Bahnschrift ships with Windows 10/11),
      each device owns one hue (by default GPU violet, CPU sky, RAM coral — user-pickable) and temperatures
      speak a separate thermal language (sea-glass → amber → red).
      The FPS figure and its frame-time trace are the only loud element.
    -->
    <UserControl.Resources>
        <!-- GpuHue / CpuHue / RamHue, their *Fill gradients and the Trace* brushes are
             user colours: OverlayCard.ApplyTheme puts them in these resources. -->
        <!-- Text is user-sized too (OverlayCard.ApplyText): each size below is the stock size, scaled in code,
             so the hierarchy always holds. -->
        <FontFamily x:Key="Digits">Bahnschrift, Segoe UI</FontFamily>
        <sys:Double x:Key="NumHero">44</sys:Double>
        <sys:Double x:Key="NumCompactHero">18</sys:Double>
        <sys:Double x:Key="NumLow">17</sys:Double>
        <sys:Double x:Key="Num">16</sys:Double>
        <sys:Double x:Key="NumHotspot">13</sys:Double>
        <sys:Double x:Key="NumSmall">12</sys:Double>
        <sys:Double x:Key="LblDevice">11</sys:Double>
        <sys:Double x:Key="LblUnit">12</sys:Double>
        <sys:Double x:Key="LblNote">10</sys:Double>
        <sys:Double x:Key="Divider">14</sys:Double>

        <!-- Ink / NumSoft: numbers; Soft / Faint: labels. Recoloured in place by OverlayCard.ApplyText. -->
        <SolidColorBrush x:Key="Ink" Color="#F6F1E7" />
        <SolidColorBrush x:Key="NumSoft" Color="#A3AAC2" />
        <SolidColorBrush x:Key="Soft" Color="#A3AAC2" />
        <SolidColorBrush x:Key="Faint" Color="#5E6680" />
        <SolidColorBrush x:Key="TrackBrush" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="RuleBrush" Color="#14FFFFFF" />

        <Style x:Key="Device" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource LblDevice}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource LblNote}" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Digits}" />
            <Setter Property="FontSize" Value="{DynamicResource Num}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FigureRight" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource NumSoft}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- liquid glass in the preview: the scene behind the card, blurred (the live overlay asks Windows to blur
             the game instead). Inflated past the card so the blur has no soft rim; the clip, set in code, cuts it to the card. -->
        <Border x:Name="Backdrop" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle x:Name="BackdropFill">
                <Rectangle.Effect>
                    <BlurEffect Radius="22" KernelType="Gaussian" RenderingBias="Performance" />
                </Rectangle.Effect>
            </Rectangle>
        </Border>

        <Border x:Name="Card" CornerRadius="16" BorderThickness="1" Padding="16,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Color="#1D2338" Offset="0" />
                    <GradientStop Color="#131727" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#0AFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid x:Name="Figures">
                <!-- ═════════ Full layout ═════════ -->
                <StackPanel x:Name="FullPanel" Width="238" Grid.IsSharedSizeScope="True">

                    <!-- benchmark running or just finished: a line of its own on top, whichever metrics are on -->
                    <TextBlock Text="{Binding BenchText}" Foreground="{Binding BenchBrush}" Visibility="{Binding BenchVisibility}"
                               Style="{StaticResource Note}" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <StackPanel x:Name="FullFps">
                        <!-- whose frames we're counting -->
                        <DockPanel LastChildFill="True">
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding FpsBrush}"
                                     VerticalAlignment="Center" Margin="0,1,8,0" />
                            <!-- what limits the frame rate: opt-in -->
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BottleneckText}" Foreground="{Binding BottleneckBrush}"
                                       Visibility="{Binding BottleneckVisibility}" Style="{StaticResource Note}"
                                       FontWeight="SemiBold" TextTrimming="None" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding TargetName}" Style="{StaticResource Note}" Foreground="{StaticResource Soft}" />
                        </DockPanel>

                        <!-- hero: FPS -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding FpsText}" Foreground="{Binding FpsBrush}"
                                       FontFamily="{StaticResource Digits}" FontSize="{DynamicResource NumHero}"
                                       Typography.NumeralAlignment="Tabular" Margin="-2,-4,0,-6" />
                            <TextBlock Grid.Column="1" Text="fps" FontSize="{DynamicResource LblUnit}" Foreground="{StaticResource Soft}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,6" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <TextBlock Text="{Binding FpsLowText}" Style="{StaticResource FigureRight}" FontSize="{DynamicResource NumLow}" />
                                <TextBlock Text="1% low" Style="{StaticResource Note}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <!-- frame-time trace -->
                        <ui:Sparkline Height="30" Margin="0,8,0,0"
                                      Values="{Binding FrameTimes}"
                                      Stroke="{DynamicResource TraceStroke}"
                                      Area="{DynamicResource TraceArea}"
                                      Baseline="{StaticResource RuleBrush}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FrameTimeText}" Style="{StaticResource Note}" />
                            <TextBlock Text="Frame time" Style="{StaticResource Note}" />
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,12,0,12" />
                    </StackPanel>

                    <!-- GPU (top margins of the device rows are set in code: only between visible rows) -->
                    <Grid x:Name="FullGpu">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="Tag" />
                            <ColumnDefinition Width="Auto" MinWidth="44" SharedSizeGroup="Temp" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="40" SharedSizeGroup="Load" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="GPU" Style="{StaticResource Device}" Foreground="{DynamicResource GpuHue}" />
                        <TextBlock Grid.Column="1" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" Style="{StaticResource Figure}" />
                        <ui:MeterBar Grid.Column="2" Height="4" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Value="{Binding GpuLoad}" Fill="{DynamicResource GpuFill}" Track="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding GpuLoadText}" Style="{StaticResource FigureRight}" />

                        <!-- hot spot (junction): only on GPUs that report it -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuHotspotText}" Foreground="{Binding GpuHotspotBrush}"
                                   Visibility="{Binding GpuHotspotVisibility}" Style="{StaticResource Figure}" FontSize="{DynamicResource NumSmall}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="hot spot" Margin="2,0,0,0"
                                   Visibility="{Binding GpuHotspotVisibility}" Style="{StaticResource Note}" />

                        <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuVramText}" Style="{StaticResource Note}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding GpuName}" Style="{StaticResource Note}" />
                        </DockPanel>
                    </Grid>

                    <!-- CPU -->
                    <Grid x:Name="FullCpu" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="Tag" />
                            <ColumnDefinition Width="Auto" MinWidth="44" SharedSizeGroup="Temp" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="40" SharedSizeGroup="Load" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CPU" Style="{StaticResource Device}" Foreground="{DynamicResource CpuHue}" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" Style="{StaticResource Figure}" />
                        <ui:MeterBar Grid.Column="2" Height="4" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Value="{Binding CpuLoad}" Fill="{DynamicResource CpuFill}" Track="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding CpuLoadText}" Style="{StaticResource FigureRight}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                                   Text="{Binding CpuName}" Style="{StaticResource Note}" />
                    </Grid>

                    <!-- RAM -->
                    <Grid x:Name="FullRam" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="Tag" />
                            <ColumnDefinition Width="Auto" MinWidth="44" SharedSizeGroup="Temp" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="40" SharedSizeGroup="Load" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="RAM" Style="{StaticResource Device}" Foreground="{DynamicResource RamHue}" />
                        <TextBlock Grid.Column="1" Text="{Binding RamUsedText}" Style="{StaticResource Figure}" />
                        <ui:MeterBar Grid.Column="2" Height="4" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Value="{Binding RamLoad}" Fill="{DynamicResource RamFill}" Track="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding RamLoadText}" Style="{StaticResource FigureRight}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                                   Text="{Binding RamTotalText}" Style="{StaticResource Note}" />
                    </Grid>
                </StackPanel>

                <!-- ═════════ Compact layout: one line for competitive play ═════════ -->
                <!-- each group but the first opens with its own divider; code hides the one that ends up leading -->
                <StackPanel x:Name="CompactPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <StackPanel x:Name="CompactFps" Orientation="Horizontal">
                        <TextBlock Text="{Binding FpsText}" Foreground="{Binding FpsBrush}" Style="{StaticResource Figure}" FontSize="{DynamicResource NumCompactHero}" />
                        <TextBlock Text="fps" FontSize="{DynamicResource LblNote}" Foreground="{StaticResource Soft}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        <TextBlock Text="{Binding BottleneckText}" Foreground="{Binding BottleneckBrush}" Visibility="{Binding BottleneckVisibility}"
                                   FontSize="{DynamicResource LblNote}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="7,0,0,3" />
                    </StackPanel>

                    <StackPanel x:Name="CompactGpu" Orientation="Horizontal">
                        <Border Width="1" Height="{DynamicResource Divider}" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="GPU" Style="{StaticResource Device}" Foreground="{DynamicResource GpuHue}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" Style="{StaticResource Figure}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding GpuHotspotVisibility}">
                            <TextBlock Text="/" Style="{StaticResource Figure}" FontSize="{DynamicResource NumSmall}" Foreground="{StaticResource Faint}" Margin="2,0" />
                            <TextBlock Text="{Binding GpuHotspotText}" Foreground="{Binding GpuHotspotBrush}" Style="{StaticResource Figure}" FontSize="{DynamicResource NumHotspot}" />
                        </StackPanel>
                        <TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource FigureRight}" Margin="7,0,0,0" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CompactVramVisibility}" Margin="7,0,0,0">
                            <TextBlock Text="{Binding GpuVramShortText}" Style="{StaticResource FigureRight}" />
                            <TextBlock Text="vram" FontSize="{DynamicResource LblNote}" Foreground="{StaticResource Soft}" VerticalAlignment="Bottom" Margin="3,0,0,3" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CompactCpu" Orientation="Horizontal">
                        <Border Width="1" Height="{DynamicResource Divider}" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="CPU" Style="{StaticResource Device}" Foreground="{DynamicResource CpuHue}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" Style="{StaticResource Figure}" />
                        <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource FigureRight}" Margin="7,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CompactRam" Orientation="Horizontal">
                        <Border Width="1" Height="{DynamicResource Divider}" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="RAM" Style="{StaticResource Device}" Foreground="{DynamicResource RamHue}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding RamLoadText}" Style="{StaticResource FigureRight}" />
                    </StackPanel>

                    <!-- benchmark: always last, so it never leads and its divider always shows -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding BenchVisibility}">
                        <Border Width="1" Height="{DynamicResource Divider}" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="{Binding BenchText}" Foreground="{Binding BenchBrush}" FontSize="{DynamicResource LblNote}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- liquid glass: a soft sheen from the top-left, and a specular rim only where light catches the glass: at the
             top-left and bottom-right corners, fading linearly along both edges from each. The rest of the edge is bare.
             Each rim is a radial fade from its corner in the card's own proportions, so a wide, short compact card
             fades along its long edge as well as its short one. -->
        <Grid x:Name="Sheen" Visibility="Collapsed" IsHitTestVisible="False">
            <Border x:Name="SheenTopLeft" CornerRadius="16" BorderThickness="1">
                <Border.Background>
                    <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.9" RadiusY="1.1">
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#0AFFFFFF" Offset="0.55" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.42" RadiusY="0.5">
                        <GradientStop Color="#E6FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Border x:Name="SheenBottomRight" CornerRadius="16" BorderThickness="1">
                <Border.BorderBrush>
                    <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.42" RadiusY="0.5">
                        <GradientStop Color="#E6FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>

        <!-- a single catch-light along the top edge -->
        <Border x:Name="CatchLight" Height="1" VerticalAlignment="Top" Margin="30,0" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#40FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
