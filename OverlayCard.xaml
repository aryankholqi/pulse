<UserControl x:Class="Pulse.OverlayCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI" FlowDirection="LeftToRight"
             TextOptions.TextRenderingMode="Grayscale">

    <!--
      Design: a night-cockpit instrument, not a HUD sticker.
      Ink-blue smoked glass, ivory DIN numerals (Bahnschrift ships with Windows 10/11),
      each device owns one hue (by default GPU violet, CPU sky, RAM coral — user-pickable) and temperatures
      speak a separate thermal language (sea-glass → amber → red).
      The FPS figure and its frame-time trace are the only loud element.
    -->
    <UserControl.Resources>
        <!-- GpuHue / CpuHue / RamHue, their *Fill gradients and the Trace* brushes are
             user colours: OverlayCard.ApplyTheme puts them in these resources. -->
        <FontFamily x:Key="Digits">Bahnschrift, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="Ink" Color="#F6F1E7" />
        <SolidColorBrush x:Key="Soft" Color="#A3AAC2" />
        <SolidColorBrush x:Key="Faint" Color="#5E6680" />
        <SolidColorBrush x:Key="TrackBrush" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="RuleBrush" Color="#14FFFFFF" />

        <Style x:Key="Device" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Digits}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FigureRight" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Border x:Name="Card" CornerRadius="16" BorderThickness="1" Padding="16,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Color="#1D2338" Offset="0" />
                    <GradientStop Color="#131727" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#0AFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <!-- ═════════ Full layout ═════════ -->
                <StackPanel x:Name="FullPanel" Width="238">

                    <StackPanel x:Name="FullFps">
                        <!-- whose frames we're counting -->
                        <DockPanel LastChildFill="True">
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding FpsBrush}"
                                     VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding TargetName}" Style="{StaticResource Note}" Foreground="{StaticResource Soft}" />
                        </DockPanel>

                        <!-- hero: FPS -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding FpsText}" Foreground="{Binding FpsBrush}"
                                       FontFamily="{StaticResource Digits}" FontSize="44"
                                       Typography.NumeralAlignment="Tabular" Margin="-2,-4,0,-6" />
                            <TextBlock Grid.Column="1" Text="fps" FontSize="12" Foreground="{StaticResource Soft}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,6" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <TextBlock Text="{Binding FpsLowText}" Style="{StaticResource FigureRight}" FontSize="17" />
                                <TextBlock Text="1% low" Style="{StaticResource Note}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <!-- frame-time trace -->
                        <ui:Sparkline Height="30" Margin="0,8,0,0"
                                      Values="{Binding FrameTimes}"
                                      Stroke="{DynamicResource TraceStroke}"
                                      Area="{DynamicResource TraceArea}"
                                      Baseline="{StaticResource RuleBrush}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FrameTimeText}" Style="{StaticResource Note}" />
                            <TextBlock Text="Frame time" Style="{StaticResource Note}" />
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,12,0,12" />
                    </StackPanel>

                    <!-- GPU (top margins of the device rows are set in code: only between visible rows) -->
                    <Grid x:Name="FullGpu">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="GPU" Style="{StaticResource Device}" Foreground="{DynamicResource GpuHue}" />
                        <TextBlock Grid.Column="1" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" Style="{StaticResource Figure}" />
                        <ui:MeterBar Grid.Column="2" Height="4" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Value="{Binding GpuLoad}" Fill="{DynamicResource GpuFill}" Track="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding GpuLoadText}" Style="{StaticResource FigureRight}" />

                        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuVramText}" Style="{StaticResource Note}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding GpuName}" Style="{StaticResource Note}" />
                        </DockPanel>
                    </Grid>

                    <!-- CPU -->
                    <Grid x:Name="FullCpu" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CPU" Style="{StaticResource Device}" Foreground="{DynamicResource CpuHue}" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" Style="{StaticResource Figure}" />
                        <ui:MeterBar Grid.Column="2" Height="4" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Value="{Binding CpuLoad}" Fill="{DynamicResource CpuFill}" Track="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding CpuLoadText}" Style="{StaticResource FigureRight}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                                   Text="{Binding CpuName}" Style="{StaticResource Note}" />
                    </Grid>

                    <!-- RAM -->
                    <Grid x:Name="FullRam" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="RAM" Style="{StaticResource Device}" Foreground="{DynamicResource RamHue}" />
                        <TextBlock Grid.Column="1" Text="{Binding RamUsedText}" Style="{StaticResource Figure}" />
                        <ui:MeterBar Grid.Column="2" Height="4" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Value="{Binding RamLoad}" Fill="{DynamicResource RamFill}" Track="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding RamLoadText}" Style="{StaticResource FigureRight}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                                   Text="{Binding RamTotalText}" Style="{StaticResource Note}" />
                    </Grid>
                </StackPanel>

                <!-- ═════════ Compact layout: one line for competitive play ═════════ -->
                <!-- each group but the first opens with its own divider; code hides the one that ends up leading -->
                <StackPanel x:Name="CompactPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <StackPanel x:Name="CompactFps" Orientation="Horizontal">
                        <TextBlock Text="{Binding FpsText}" Foreground="{Binding FpsBrush}" Style="{StaticResource Figure}" FontSize="18" />
                        <TextBlock Text="fps" FontSize="10" Foreground="{StaticResource Soft}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                    </StackPanel>

                    <StackPanel x:Name="CompactGpu" Orientation="Horizontal">
                        <Border Width="1" Height="14" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="GPU" Style="{StaticResource Device}" Foreground="{DynamicResource GpuHue}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" Style="{StaticResource Figure}" />
                        <TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource FigureRight}" Margin="7,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CompactCpu" Orientation="Horizontal">
                        <Border Width="1" Height="14" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="CPU" Style="{StaticResource Device}" Foreground="{DynamicResource CpuHue}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" Style="{StaticResource Figure}" />
                        <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource FigureRight}" Margin="7,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CompactRam" Orientation="Horizontal">
                        <Border Width="1" Height="14" Background="{StaticResource RuleBrush}" Margin="12,0" />
                        <TextBlock Text="RAM" Style="{StaticResource Device}" Foreground="{DynamicResource RamHue}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding RamLoadText}" Style="{StaticResource FigureRight}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- a single catch-light along the top edge -->
        <Border Height="1" VerticalAlignment="Top" Margin="30,0" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#40FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
