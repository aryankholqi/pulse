<UserControl x:Class="Pulse.BoostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pulse"
             xmlns:controls="clr-namespace:Pulse.Controls">

    <!--
      Boost: what Pulse changes while a game runs, the NVIDIA power limit, and why the GPU slows down.
      Panel / SectionTitle / Hint / PageTitle are the settings window's styles: DynamicResource finds them once hosted.
    -->
    <UserControl.Resources>
        <!-- the small square icon at the start of a boost row -->
        <Style x:Key="RowIcon" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource Sunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{local:T NavBoost}" Style="{DynamicResource PageTitle}" />
            <TextBlock Text="{local:T BoostPageHint}" Style="{DynamicResource Hint}" FontSize="12.5" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ═════════ status: waiting, or boosting a game and what is on ═════════ -->
                    <Border Grid.ColumnSpan="3" Style="{DynamicResource Panel}" Padding="18">
                        <DockPanel>
                            <Border x:Name="StatusTile" DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="15" VerticalAlignment="Top"
                                    Background="{StaticResource AccentWash}">
                                <TextBlock x:Name="StatusGlyph" Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource Accent}" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <DockPanel>
                                    <Border x:Name="StatusBadge" DockPanel.Dock="Left" CornerRadius="9" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="StatusTitle" FontSize="17" Style="{StaticResource Big}" FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="StatusText" Style="{DynamicResource Hint}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                                <WrapPanel x:Name="StatusChips" Margin="0,10,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ═════════ while you play ═════════ -->
                    <StackPanel Grid.Row="1">
                        <Border Style="{DynamicResource Panel}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{local:T BoostWhenHint}" Style="{DynamicResource Hint}" />
                                    <TextBlock Text="{local:T BoostWhilePlaying}" Style="{DynamicResource SectionTitle}" />
                                </DockPanel>

                                <StackPanel Margin="-12,-2,-12,-6">
                                    <CheckBox x:Name="PlanSwitch" Style="{StaticResource RowSwitch}">
                                        <DockPanel>
                                            <Border Style="{StaticResource RowIcon}"><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" /></Border>
                                            <StackPanel>
                                                <TextBlock Text="{local:T BoostPlan}" FontWeight="SemiBold" />
                                                <TextBlock Text="{local:T BoostPlanHint}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource RowRule}" />

                                    <CheckBox x:Name="PrioritySwitch" Style="{StaticResource RowSwitch}">
                                        <DockPanel>
                                            <Border Style="{StaticResource RowIcon}"><TextBlock Text="&#xE74A;" Style="{StaticResource Glyph}" /></Border>
                                            <StackPanel>
                                                <TextBlock Text="{local:T BoostPriority}" FontWeight="SemiBold" />
                                                <TextBlock Text="{local:T BoostPriorityHint}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource RowRule}" />

                                    <CheckBox x:Name="BackgroundSwitch" Style="{StaticResource RowSwitch}">
                                        <DockPanel>
                                            <Border Style="{StaticResource RowIcon}"><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" /></Border>
                                            <StackPanel>
                                                <TextBlock Text="{local:T BoostBackground}" FontWeight="SemiBold" />
                                                <TextBlock Text="{local:T BoostBackgroundHint}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource RowRule}" />

                                    <CheckBox x:Name="VCacheSwitch" Style="{StaticResource RowSwitch}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel>
                                            <Border Style="{StaticResource RowIcon}"><TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" /></Border>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{local:T BoostVCache}" FontWeight="SemiBold" />
                                                    <Border CornerRadius="6" Background="{StaticResource AccentWash}" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Ryzen X3D" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="VCacheHint" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,12" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Text="{local:T BoostUndoNote}" Style="{DynamicResource Hint}" Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="18" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <!-- ═════════ GPU power limit ═════════ -->
                        <Border Style="{DynamicResource Panel}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="PowerReset" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="{local:T PowerReset}" VerticalAlignment="Top" />
                                    <TextBlock Text="{local:T PowerTitle}" Style="{DynamicResource SectionTitle}" />
                                </DockPanel>

                                <StackPanel x:Name="PowerBody">
                                    <DockPanel>
                                        <!-- live draw: what the card pulls right now, against the limit -->
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,2">
                                            <TextBlock x:Name="PowerDraw" FontSize="15" Style="{StaticResource Big}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{local:T PowerDrawNow}" Style="{DynamicResource Hint}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                                <TextBlock x:Name="PowerPercent" FontSize="34" Style="{StaticResource Big}" />
                                                <TextBlock x:Name="PowerTag" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,7" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <TextBlock x:Name="PowerWatts" Style="{DynamicResource Hint}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- draw vs limit -->
                                    <controls:MeterBar x:Name="PowerMeter" Height="5" Margin="0,12,0,0" Track="{StaticResource Sunken}" Fill="{StaticResource Faint}"
                                                       FlowDirection="LeftToRight" />

                                    <Slider x:Name="PowerSlider" Style="{StaticResource Slim}" Margin="0,16,0,6" SmallChange="1" LargeChange="5"
                                            IsSnapToTickEnabled="True" TickFrequency="1" FlowDirection="LeftToRight"
                                            AutomationProperties.Name="{local:T PowerTitle}" />
                                    <DockPanel Margin="0,0,0,12" FlowDirection="LeftToRight">
                                        <TextBlock x:Name="PowerMax" DockPanel.Dock="Right" Style="{DynamicResource Hint}" FontSize="11" />
                                        <TextBlock x:Name="PowerMin" Style="{DynamicResource Hint}" FontSize="11" />
                                    </DockPanel>

                                    <Border Style="{StaticResource Segmented}">
                                        <UniformGrid x:Name="PowerPresets" Rows="1" />
                                    </Border>

                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock x:Name="PowerNoteGlyph" DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="12"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock x:Name="PowerNote" Style="{DynamicResource Hint}" Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="18" />
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock x:Name="PowerUnavailable" Style="{DynamicResource Hint}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- ═════════ throttle check ═════════ -->
                        <Border Style="{DynamicResource Panel}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{local:T ThrottleLive}" Style="{DynamicResource Hint}" />
                                    <TextBlock Text="{local:T ThrottleTitle}" Style="{DynamicResource SectionTitle}" />
                                </DockPanel>

                                <StackPanel x:Name="ThrottleBody">
                                    <Border x:Name="ThrottleCard" CornerRadius="12" Padding="14,12" BorderThickness="1">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Top" Margin="0,5,12,0">
                                                <Ellipse x:Name="ThrottleHalo" Width="12" Height="12" Opacity="0.3" />
                                                <Ellipse x:Name="ThrottleDot" Width="7" Height="7" />
                                            </Grid>
                                            <StackPanel>
                                                <TextBlock x:Name="ThrottleState" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ThrottleWhy" Style="{DynamicResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="18" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="{local:T ThrottleMinute}" Style="{DynamicResource Hint}" FontWeight="SemiBold" Margin="0,16,0,10" />
                                    <Grid x:Name="ThrottleBars">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{local:T ThrottlePower}" Foreground="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <controls:MeterBar x:Name="BarPower" Grid.Column="1" Height="6" Track="{StaticResource Sunken}" />
                                        <TextBlock x:Name="ValPower" Grid.Column="2" Style="{DynamicResource Hint}" TextAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />

                                        <TextBlock Grid.Row="1" Text="{local:T ThrottleHeat}" Foreground="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <controls:MeterBar x:Name="BarHeat" Grid.Row="1" Grid.Column="1" Height="6" Track="{StaticResource Sunken}" />
                                        <TextBlock x:Name="ValHeat" Grid.Row="1" Grid.Column="2" Style="{DynamicResource Hint}" TextAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />

                                        <TextBlock Grid.Row="2" Text="{local:T ThrottleHardware}" Foreground="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <controls:MeterBar x:Name="BarHardware" Grid.Row="2" Grid.Column="1" Height="6" Track="{StaticResource Sunken}" />
                                        <TextBlock x:Name="ValHardware" Grid.Row="2" Grid.Column="2" Style="{DynamicResource Hint}" TextAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                    </Grid>
                                    <TextBlock x:Name="ThrottleIdle" Text="{local:T ThrottleNoLoad}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="ThrottleUnavailable" Style="{DynamicResource Hint}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═════════ undervolt (advanced): clock cap + curve offset, on trial until kept ═════════ -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{DynamicResource Panel}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="TuneUnlock" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="{local:T TuneUnlock}" VerticalAlignment="Top" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{local:T TuneTitle}" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    <Border CornerRadius="6" Background="#26FFD166" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{local:T TuneAdvanced}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFD166" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{local:T TuneIntro}" Foreground="{StaticResource Soft}" TextWrapping="Wrap" LineHeight="19" />

                            <!-- locked: what can go wrong, and how Pulse protects against it -->
                            <Border x:Name="TuneWarning" Margin="0,14,0,0" CornerRadius="12" Padding="14,12" Background="#14FFD166" BorderBrush="#40FFD166" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#FFD166" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{local:T TuneRiskTitle}" FontWeight="SemiBold" Foreground="#FFD166" />
                                        <TextBlock Text="{local:T TuneRisk}" Style="{DynamicResource Hint}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Afterburner & co. write the same clocks: the two would overwrite each other -->
                            <Border x:Name="TuneConflict" Margin="0,14,0,0" CornerRadius="12" Padding="14,12" Background="#14FF9A85" BorderBrush="#40FF9A85" BorderThickness="1" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#FF9A85" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <TextBlock x:Name="TuneConflictText" Style="{DynamicResource Hint}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                </DockPanel>
                            </Border>

                            <Grid x:Name="TuneBody" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- the two controls -->
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="CapValue" DockPanel.Dock="Right" FontSize="15" Style="{StaticResource Big}" />
                                        <StackPanel>
                                            <TextBlock Text="{local:T TuneCap}" FontWeight="SemiBold" />
                                            <TextBlock Text="{local:T TuneCapHint}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Slider x:Name="CapSlider" Style="{StaticResource Slim}" Margin="0,10,0,4" SmallChange="15" LargeChange="60"
                                            IsSnapToTickEnabled="True" TickFrequency="15" FlowDirection="LeftToRight" AutomationProperties.Name="{local:T TuneCap}" />
                                    <Button x:Name="UseGameClock" Style="{DynamicResource InfoButton}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Accent}" />
                                            <TextBlock x:Name="UseGameClockText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />

                                    <StackPanel x:Name="OffsetRow">
                                        <DockPanel>
                                            <TextBlock x:Name="OffsetValue" DockPanel.Dock="Right" FontSize="15" Style="{StaticResource Big}" />
                                            <StackPanel>
                                                <TextBlock Text="{local:T TuneOffset}" FontWeight="SemiBold" />
                                                <TextBlock Text="{local:T TuneOffsetHint}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider x:Name="OffsetSlider" Style="{StaticResource Slim}" Margin="0,10,0,0" SmallChange="15" LargeChange="15"
                                                IsSnapToTickEnabled="True" TickFrequency="15" FlowDirection="LeftToRight" AutomationProperties.Name="{local:T TuneOffset}" />
                                        <TextBlock x:Name="OffsetNeedsCap" Text="{local:T TuneOffsetNeedsCap}" Style="{DynamicResource Hint}" Foreground="#FFD166"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="OffsetUnsupported" Text="{local:T TuneNoOffset}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>

                                <!-- where it stands: trial / kept / crashed, and the card live -->
                                <StackPanel Grid.Column="2">
                                    <Border x:Name="TuneStatus" CornerRadius="12" Padding="14,12" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="TuneDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock x:Name="TuneStatusTitle" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock x:Name="TuneStatusText" Style="{DynamicResource Hint}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0" />
                                            <StackPanel x:Name="TuneActions" Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="TuneKeep" Style="{StaticResource Primary}" Content="{local:T TuneKeep}" />
                                                <Button x:Name="TuneUndo" Style="{StaticResource Ghost}" Content="{local:T TuneUndo}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Rows="1" Margin="0,12,0,0">
                                        <Border Background="{StaticResource Sunken}" CornerRadius="10" Padding="12,10" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="{local:T TuneLiveClock}" Style="{DynamicResource Hint}" />
                                                <TextBlock x:Name="LiveClock" FontSize="17" Style="{StaticResource Big}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Sunken}" CornerRadius="10" Padding="12,10" Margin="4,0">
                                            <StackPanel>
                                                <TextBlock Text="{local:T TuneLivePower}" Style="{DynamicResource Hint}" />
                                                <TextBlock x:Name="LivePower" FontSize="17" Style="{StaticResource Big}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Sunken}" CornerRadius="10" Padding="12,10" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{local:T TuneLiveTemp}" Style="{DynamicResource Hint}" />
                                                <TextBlock x:Name="LiveTemp" FontSize="17" Style="{StaticResource Big}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Text="{local:T TuneCompareHint}" Style="{DynamicResource Hint}" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- the beginner's guide: shown before unlocking too, so it can be read first -->
                            <Border x:Name="TuneGuide" Margin="0,16,0,0" CornerRadius="12" Padding="16,14" Background="{DynamicResource AccentWash}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE82F;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                        <TextBlock Text="{local:T TuneGuideTitle}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{local:T TuneGuideWhat}" Foreground="{StaticResource Soft}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,4" />
                                    <ItemsControl Focusable="False">
                                        <ItemsControl.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="LineHeight" Value="19" />
                                                <Setter Property="Margin" Value="0,8,0,0" />
                                            </Style>
                                        </ItemsControl.Resources>
                                        <TextBlock Text="{local:T TuneGuide1}" />
                                        <TextBlock Text="{local:T TuneGuide2}" />
                                        <TextBlock Text="{local:T TuneGuide3}" />
                                        <TextBlock Text="{local:T TuneGuide4}" />
                                        <TextBlock Text="{local:T TuneGuide5}" />
                                        <TextBlock Text="{local:T TuneGuide6}" />
                                        <TextBlock Text="{local:T TuneGuide7}" />
                                        <TextBlock Text="{local:T TuneGuide8}" />
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TuneUnavailable" Style="{DynamicResource Hint}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
