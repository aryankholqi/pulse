<Window x:Class="Pulse.SavedSummariesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pulse"
        xmlns:controls="clr-namespace:Pulse.Controls"
        Title="{local:T SavedTitle}"
        Width="760" MinWidth="400" MinHeight="300" SizeToContent="Height" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}">

    <!-- The game summaries the player saved: open one, or delete it from the records. -->
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header: pulse mark + headline -->
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A314E" Offset="0" />
                        <GradientStop Color="#131727" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Path Data="M5,21 L12,21 L15,14 L20,28 L24,9 L27,21 L35,21" Stroke="{StaticResource Accent}" StrokeThickness="2.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{local:T SavedTitle}" FontSize="17" FontWeight="SemiBold" FontFamily="Bahnschrift, Segoe UI"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{local:T SavedSubtitle}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
            </ScrollViewer.Resources>
            <controls:SavedSummaryList x:Name="List" />
        </ScrollViewer>

        <Button x:Name="OkButton" Grid.Row="2" Style="{StaticResource Primary}" Content="{local:T WhatsNewOk}" HorizontalAlignment="Right"
                Margin="0,16,0,0" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
