<Window x:Class="Pulse.BottleneckGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pulse"
        Title="{local:T BottleneckGuideTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}">

    <!-- GPU-bound / CPU-bound / Capped: one card each, what it means and what to do. -->
    <StackPanel Margin="24,22,24,20">

        <!-- header: pulse mark + headline -->
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A314E" Offset="0" />
                        <GradientStop Color="#131727" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Path Data="M5,21 L12,21 L15,14 L20,28 L24,9 L27,21 L35,21" Stroke="{StaticResource Accent}" StrokeThickness="2.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{local:T Bottleneck}" FontSize="17" FontWeight="SemiBold" FontFamily="Bahnschrift, Segoe UI" />
                <TextBlock Text="{local:T BottleneckGuideSubtitle}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Margin="0,18,0,0" MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="Modes" />
        </ScrollViewer>

        <DockPanel Margin="0,16,0,0">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{local:T WhatsNewOk}"
                    IsDefault="True" IsCancel="True" VerticalAlignment="Center" />
            <TextBlock x:Name="Footnote" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>
    </StackPanel>
</Window>
