<Window x:Class="Pulse.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pulse"
        Title="{local:T WhatsNewTitle}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}">

    <!-- "Pulse has been updated": the version, what changed in plain words, one button. -->
    <StackPanel Margin="24,22,24,20">

        <!-- header: pulse mark + headline -->
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A314E" Offset="0" />
                        <GradientStop Color="#131727" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Path Data="M5,21 L12,21 L15,14 L20,28 L24,9 L27,21 L35,21" Stroke="{StaticResource Accent}" StrokeThickness="2.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{local:T WhatsNewHeadline}" FontSize="17" FontWeight="SemiBold" FontFamily="Bahnschrift, Segoe UI" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,3,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <!-- what changed -->
        <Border Margin="0,18,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{local:T UpdateWhatsNew}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="Changes" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{local:T WhatsNewOk}"
                    IsDefault="True" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
