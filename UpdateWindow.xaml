<Window x:Class="Pulse.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pulse"
        Title="{local:T UpdateTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}">

    <!-- "A new Pulse is out": version jump, what's new, one clear primary action. -->
    <StackPanel Margin="24,22,24,20">

        <!-- header: pulse mark + headline -->
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A314E" Offset="0" />
                        <GradientStop Color="#131727" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Path Data="M5,21 L12,21 L15,14 L20,28 L24,9 L27,21 L35,21" Stroke="{StaticResource Accent}" StrokeThickness="2.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{local:T UpdateHeadline}" FontSize="17" FontWeight="SemiBold" FontFamily="Bahnschrift, Segoe UI" />
                <!-- 1.0.0 → 1.1.0: versions read left-to-right in both languages -->
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,3,0,0">
                    <TextBlock x:Name="FromVersion" Foreground="{StaticResource Muted}" FontSize="12.5" />
                    <TextBlock Text="  →  " Foreground="{StaticResource Faint}" FontSize="12.5" />
                    <TextBlock x:Name="ToVersion" Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- what's new -->
        <Border x:Name="NotesPanel" Margin="0,18,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{local:T UpdateWhatsNew}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                    </ScrollViewer.Resources>
                    <!-- release notes are written in English -->
                    <TextBlock x:Name="Notes" TextWrapping="Wrap" Foreground="{StaticResource Soft}" LineHeight="20" FlowDirection="LeftToRight" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- download progress (replaces the note once Update is pressed) -->
        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" FlowDirection="LeftToRight" />
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource Soft}" FontSize="12" />
            </DockPanel>
            <Grid x:Name="ProgressTrack" Height="4" Margin="0,8,0,0">
                <Border Background="{StaticResource Sunken}" CornerRadius="2" />
                <Border x:Name="ProgressFill" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="Note" Text="{local:T UpdateNote}" Margin="0,14,0,0" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Margin="0,14,0,0" FontSize="12" Foreground="#FF746C" TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- actions: skip is quiet, later is secondary, update is the one thing that stands out -->
        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Style="{StaticResource Link}" Content="{local:T UpdateSkip}" VerticalAlignment="Center" />
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{local:T UpdateNow}" IsDefault="True" />
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{local:T UpdateLater}" IsCancel="True" Margin="0,0,10,0" />
        </DockPanel>
    </StackPanel>
</Window>
